{
  "name": "hackathon-backend",
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "biome check src/",
    "lint:fix": "yarn biome lint --fix",
    "format": "biome format --write src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "6.1.0",
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.7.0",
    "fuse.js": "^7.3.0",
    "helmet": "^7.1.0",
    "node-cron": "^4.2.1",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/axios": "^0.14.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.2",
    "prisma": "6.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
